  "owner": "andoshin11",
  "plugins": [
    {
      "id": "andoshin11.agent-status-relay",
      "source": {
        "kind": "git",
        "url": "https://github.com/andoshin11/orca-agent-status-relay",
        "ref": "main"
      },
      "description": "Forwards agent status changes (turn done, waiting, blocked) to a URL you configure, signed with Standard Webhooks. Used by orca-dots-bridge to notify ChatGPT dot.",
      "categories": [
        "notifications"
      ],
      "releases": [
        {
          "version": "0.2.0",
          "commit": "15a7100ec2751a016afe9dbd7bf5f61783aed5f8",
          "contentHash": "d094dca2dfbbe74cc61fda77cac807ffab4cb15dd5c9cd519bca9fe66b3a2f39",
          "execution": "trusted-worker",
          "minimumOrca": "1.4.245",
          "name": "Agent Status Relay",
          "contributes": [
            {
              "kind": "commands",
              "name": "Agent Status Relay: Send test event"
            },
            {
              "kind": "events",
              "name": "agent.status.changed"
            }
          ],
          "capabilities": [
            "agent:read"
          ],
          "changelog": "manifest format 2 に移しました。動作は変わりません。",
          "repository": "https://github.com/andoshin11/orca-agent-status-relay",
          "license": "MIT"
        }
      ]
    },
